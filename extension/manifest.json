{
  "manifest_version": 3,
  "name": "Between the Lines: open PDFs to take notes",
  "short_name": "Between the Lines",
  "description": "PDFs you open in your browser, and PDF, PowerPoint and Word files you download, open in Between the Lines, ready for notes.",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Between the Lines",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ylp-games.github.io/Between-the-lines/*"
      ],
      "js": [
        "mark.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "contextMenus",
    "downloads",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-tab": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open this tab's PDF in Between the Lines"
    }
  }
}
